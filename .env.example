# Optional. A jev-compatible classifier used for judgement calls that document
# structure cannot settle (theme, typography, ambiguous tables, hero image).
# Without these the renderer falls back to its built-in rules.
STUNNING_MD_CLASSIFIER_URL=https://your-classifier.example/v1/classifier
STUNNING_MD_CLASSIFIER_KEY=

# Optional. An OpenAI-compatible chat model. With it, the page takes requests:
# answers are laid out as content and the model's remarks go to a sidebar.
# The key may be left empty for providers that need none (a local model, say).
# The address may be the API's base (…/v1) or the full …/chat/completions.
STUNNING_MD_CHAT_URL=
STUNNING_MD_CHAT_MODEL=
STUNNING_MD_CHAT_KEY=

# Optional, build-time only. Set when the site is served from a sub-path,
# e.g. a GitHub project page: NEXT_PUBLIC_BASE_PATH=/stunning-md
# NEXT_PUBLIC_BASE_PATH=

# Optional, build-time only, for a static export copied to a host that answers
# <base>/api/classify and <base>/api/chat itself: GET says {"configured": true},
# POST behaves as the routes in src/app/api do. The page then uses them.
# NEXT_PUBLIC_SITE_API=1

# Optional, build-time only. Open on a blank page to chat into, when the site
# has a chat model, where the landing page would be: the button beside the input
# then starts a new blank page, and `?open` in the address asks for the landing page.
# NEXT_PUBLIC_START=blank

# Optional, build-time only. A name and a square 512 px PNG make the site
# installable to a phone's home screen. The icon must be reachable without a login.
# NEXT_PUBLIC_APP_NAME=
# NEXT_PUBLIC_APP_ICON=
