# Optional. A jev-compatible classifier used for judgement calls that document
# structure cannot settle (theme, typography, ambiguous tables, hero image).
# Without these the renderer falls back to its built-in rules.
STUNNING_MD_CLASSIFIER_URL=https://your-classifier.example/v1/classifier
STUNNING_MD_CLASSIFIER_KEY=

# Optional. An OpenAI-compatible chat model. With it, the page takes requests:
# answers are laid out as content and the model's remarks go to a sidebar.
# The key may be left empty for providers that need none (a local model, say).
STUNNING_MD_CHAT_URL=
STUNNING_MD_CHAT_MODEL=
STUNNING_MD_CHAT_KEY=

# Optional, build-time only. Set when the site is served from a sub-path,
# e.g. a GitHub project page: NEXT_PUBLIC_BASE_PATH=/stunning-md
# NEXT_PUBLIC_BASE_PATH=
