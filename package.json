{
  "name": "stunning-md",
  "version": "0.2.1",
  "description": "Turn any markdown document — a file, or a model's answer as it streams — into a designed, responsive web page.",
  "keywords": [
    "markdown",
    "react",
    "nextjs",
    "renderer",
    "charts",
    "themes",
    "shadcn",
    "remark",
    "streaming",
    "ai",
    "llm",
    "chat"
  ],
  "license": "MIT",
  "author": "Thomas Gorissen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serrynaimo/stunning-md.git"
  },
  "homepage": "https://serrynaimo.github.io/stunning-md/",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "module": "./dist/index.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:static": "STATIC_EXPORT=1 next build",
    "build:lib": "tsup && tailwindcss -i src/stunning-md/package.css -o dist/styles.css --minify",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:lib"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@types/mdast": "^4.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "generative-charts": "^0.2.0",
    "katex": "^0.18.10",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.49.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/hast": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "next": "16.3.8",
    "playwright-core": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
